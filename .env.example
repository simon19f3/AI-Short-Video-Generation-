GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional self-hosted ACE-Step 1.5. Empty uses the original local score.
ACESTEP_URL=
ACESTEP_API_KEY=

# Optional Wan 2.2. Set all three to enable image-to-video for marked shots.
WAN_PYTHON=
WAN_REPO=
WAN_CHECKPOINT=
# WAN_SIZE=1280*704
# WAN_TIMEOUT=1800

# Set to 1 after recording permission for recognizable people in the referenced photos.
ALLOW_PERSONAL_REFERENCES=0
